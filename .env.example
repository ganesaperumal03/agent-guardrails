# Copy this file to .env

# ---------- Database ----------
# postgres = real database (start it with: docker compose up -d, then: python -m app.db)
# memory   = JSON files, nothing to install (good for a first try)
DATA_BACKEND=postgres
DATABASE_URL=postgresql://novapay:novapay@localhost:5432/novapay

# ---------- LLM (AWS Bedrock, Qwen) ----------
# none    = simple rules write the report (no AWS needed)
# bedrock = Qwen on AWS Bedrock writes the report
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
# AWS login: run `aws configure`, or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# Never commit real keys to GitHub!

# Price per 1,000 tokens (USD). Check the AWS Bedrock pricing page for your region.
PRICE_IN_PER_1K=0.00015
PRICE_OUT_PER_1K=0.0006

# ---------- MCP ----------
USE_MCP=false
